{
  "name": "classinshop-test-suite",
  "version": "0.1.0",
  "private": true,
  "description": "ClassIn 小店统一测试套件：接口自动化、Web/H5 端到端、小程序自动化与性能压测",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "setup": "pnpm install && pnpm install:browsers",
    "install:browsers": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install --with-deps",
    "test": "playwright test",
    "test:api": "tsx scripts/run-api.ts",
    "test:e2e:web": "tsx scripts/run-api.ts --project e2e-web",
    "test:e2e:mobile": "tsx scripts/run-api.ts --project e2e-mobile",
    "prepare:mp": "tsx scripts/prepare-miniprogram.ts",
    "prepare:mp:user": "tsx scripts/prepare-miniprogram.ts --target user",
    "prepare:mp:teacher": "tsx scripts/prepare-miniprogram.ts --target teacher",
    "test:mp": "tsx scripts/run-api.ts --project miniprogram",
    "test:mp:user": "tsx scripts/run-api.ts --project miniprogram-user",
    "test:mp:teacher": "tsx scripts/run-api.ts --project miniprogram-teacher",
    "report": "playwright show-report reports/html",
    "report:allure": "allure generate reports/allure-results --clean -o reports/allure-html",
    "report:allure:open": "allure open reports/allure-html",
    "codegen:api": "openapi-typescript ../classinshop-go/api/http/docs/swagger.json -o shared/api/schema.d.ts",
    "perf:baseline": "k6 run perf/scenarios/api-baseline.js",
    "perf:order": "k6 run perf/scenarios/order-load.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "allure-commandline": "^2.42.1",
    "allure-playwright": "^3.10.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "miniprogram-automator": "^0.12.1",
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}

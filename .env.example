# 复制本文件为 .env.local 并填入真实账号/令牌；.env.local 已被 gitignore，切勿提交真实凭据。
# 环境域名类变量已在 .env.13 / .env.14 / .env.im 中预置，通常无需在此覆盖。

# 被测环境：13 | 14 | im（默认 13），等价于 TEST_ENV=13 pnpm test:api
TEST_ENV=13

# ---- 后端 API ----
API_HOST=https://dynamic-shop13.eeo.im
SHOP_HOST=https://shop13.eeo.im
LOGIN_ORIGIN=https://accounts13.eeo.im
STATIC_HOST=https://static-shop13.eeo.im

# 被测店铺 ID（商家后台 /shop/:shopId 接口，写入 .env.13 / .env.14 / .env.im）
SHOP_ID=

# ---- 鉴权 ----
# 方式一：直接提供已登录用户的 accessToken（最稳，推荐 CI 使用）
TEST_TOKEN=
# H5/C 端用户 accessToken；用于与商家后台 TEST_TOKEN 分离的领券、下单等场景
MOBILE_TEST_TOKEN=
# 用户端小程序 UI 自动化 accessToken；可与 MOBILE_TEST_TOKEN 同值，但必须使用独立变量名维护
MINIPROGRAM_USER_TEST_TOKEN=
# 教师端小程序 UI 自动化 accessToken；可与 TEST_TOKEN 同值，但必须使用独立变量名维护
MINIPROGRAM_TEACHER_TEST_TOKEN=
# 方式二：白名单手机号登录（/api/v1/user/loginbywhiteuser，14 分支接口巡检专用）
# 商家/教师端 → 自动填充 TEST_TOKEN、MINIPROGRAM_TEACHER_TEST_TOKEN
TEST_PHONE_NUMBER=
TEST_NATION_CODE=86
# 用户/C 端 → 自动填充 MOBILE_TEST_TOKEN、MINIPROGRAM_USER_TEST_TOKEN
MOBILE_TEST_PHONE_NUMBER=
MOBILE_TEST_NATION_CODE=86
# 方式三：签名登录（/api/v1/user/loginbysign），需要 ClassIn 颁发的签名串
TEST_EEO_UID=
TEST_SIGN_KEY=
TEST_SIGN_TIMESTAMP=
TEST_DEVICE=test-suite

# ---- E2E 前端站点 ----
WEB_BASE_URL=https://shop13.eeo.im
# C 端 H5 店铺 URL：Mobile E2E baseURL，同时作为 API X-Shop-Domain
MOBILE_BASE_URL=https://demo.shop13.eeo.im
# UI 自动化步骤截图开关；设为 1 时，Web/H5/小程序用例会在关键步骤后附加截图到报告
E2E_STEP_SCREENSHOTS=0

# ---- E2E 登录账号（如站点支持账号密码登录）----
E2E_USERNAME=
E2E_PASSWORD=

# ---- 企微通知 ----
# 默认 Webhook 见 config/wecom.ts；如需覆盖可设 WECOM_WEBHOOK_URL
# WECOM_WEBHOOK_URL=
# 静态报告发布成功后，企微通知前最多等待秒数（默认 30；设为 0 关闭）
# WECOM_PUBLISH_WAIT_SECONDS=30

# CI test-suite 项目选择（api | e2e-web | e2e-mobile，逗号分隔）
# TEST_SUITE_PROJECTS=api,e2e-web,e2e-mobile
# BRANCH_TEST_SUITE_PROJECTS=api
# SCHEDULE_TEST_SUITE_PROJECTS=api,e2e-web,e2e-mobile
# TEST_SUITE_API_SPEC=tests/api/api-demo.spec.ts

# ---- 报告发布到 Coolify 静态站点 ----
REPORT_PUBLISH_BASE_URL=https://classinshop-test-reports.coolify.eeo-inc.com
REPORT_PUBLISH_GIT_REPO=https://skills.eeo-inc.com/kailiang.qiu/classinshop-test-reports.git
# GitLab CI Variables 中配置（Masked）：与 ~/.coolify-token 同 scope 的 PAT
REPORT_PUBLISH_GIT_TOKEN=

# ---- 小程序自动化（仅本地需要）----
# 微信开发者工具 CLI 路径（macOS 默认见 docs/run-guide.md）
WX_DEVTOOLS_CLI=/Applications/wechatwebdevtools.app/Contents/MacOS/cli
# uni-app 编译产物目录（mp-weixin）
MP_USER_PROJECT=../classinshop-miniprogram/dist/build/mp-weixin
MP_TEACHER_PROJECT=../classinshop-teacher-miniprogram/dist/build/mp-weixin
